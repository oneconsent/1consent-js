{
    "name": "@1consent/react",
    "version": "0.1.0-beta.0",
    "description": "React 19 consent components and hooks for the 1Consent CMP.",
    "type": "module",
    "sideEffects": false,
    "license": "MIT",
    "keywords": [
        "consent",
        "cmp",
        "privacy",
        "react",
        "typescript"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/oneconsent/1consent-js.git",
        "directory": "packages/libs/react"
    },
    "homepage": "https://github.com/oneconsent/1consent-js/tree/main/packages/libs/react#readme",
    "bugs": {
        "url": "https://github.com/oneconsent/1consent-js/issues"
    },
    "publishConfig": {
