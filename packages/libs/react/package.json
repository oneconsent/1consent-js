        "provenance": true,
        "registry": "https://registry.npmjs.org/",
        "tag": "beta"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "files": [
        "dist/index.js",
        "dist/index.d.ts",
        "dist/react-server.js",
        "dist/react-server.d.ts",
